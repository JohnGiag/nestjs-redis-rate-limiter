# Copy to .env and adjust. Real environment variables override .env.

# HTTP port (optional, defaults to 3000)
PORT=3000

# Redis connection, required. Format: redis://[:password@]host:port[/db]
REDIS_URL=redis://localhost:6379

# Proxies/load balancers in front of the app (0 = none). Must match reality:
# too high lets clients spoof their IP via X-Forwarded-For, too low makes all clients share one IP.
TRUST_PROXY_HOPS=0

# Docker only: 1 makes nginx add an X-Upstream header naming the replica that answered.
# Needed by `npm run test:docker` to check load spreading. Keep 0 in production: it reveals internal addresses.
EXPOSE_UPSTREAM=1

# Optional: connect through Redis Sentinel instead of REDIS_URL (see compose.sentinel.yaml).
# REDIS_SENTINELS=sentinel-1:26379,sentinel-2:26379,sentinel-3:26379
# REDIS_SENTINEL_NAME=mymaster
# REDIS_PASSWORD=   # Sentinel mode only: used for both Redis and the Sentinels
